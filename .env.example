# PostgreSQL
# Local dev (docker-compose in this repo maps it to port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/siteflow?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/siteflow?schema=public"

# Hosted (Neon) — copy BOTH strings from the Neon dashboard:
#   DATABASE_URL = the POOLED connection string (append &pgbouncer=true&connection_limit=5)
#   DIRECT_URL   = the DIRECT (unpooled) connection string
#DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5"
#DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Scheduler / cron endpoint protection (GET|POST /api/cron/notifications)
CRON_SECRET="change-me-cron-secret"

# ---- Optional external notification channels ----
# Email via SMTP (can also be configured at runtime in Admin → Settings → Email)
# These env vars are a fallback; values saved in Settings take priority.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"        # true for port 465 (SSL/TLS), false for 587 (STARTTLS)
SMTP_USER=""
SMTP_PASS=""
# From header for outgoing email
EMAIL_FROM="SiteFlow <notifications@yourdomain.com>"
# Email via Resend API (fallback when SMTP is not configured)
RESEND_API_KEY=""
# SMS via Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
